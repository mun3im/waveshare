// Template for wifi_credentials.h — copy this file to wifi_credentials.h and
// fill in your own network. The real wifi_credentials.h is gitignored so the
// credentials never get committed; this template is what's committed instead.
//
//     cp wifi_credentials.h.example wifi_credentials.h
//
// Used by PrayerTimes.ino at boot, in connect_wifi_and_sync_time_headless(),
// which runs before the LCD/LVGL come up. WiFi is only needed to sync the clock
// over NTP — the prayer times themselves are compiled in (prayer_times_data.h),
// so nothing here is used after boot. Sync is attempted once with no retry; if
// it fails, the screen shows a status message instead of a wrong time.
//
// 2.4 GHz only — the ESP32-S3 has no 5 GHz radio.
#pragma once

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"
